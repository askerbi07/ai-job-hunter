# ================= LLM (Ollama / LM Studio, OpenAI-совместимый API) =================
OLLAMA_BASE_URL=http://localhost:11434/v1
# Модель: имя из LM Studio (Settings → Server → Models) или из Ollama (ollama list)
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_API_KEY=ollama

# ================= hh.ru =================
# hh.ru требует User-Agent, идентифицирующий приложение (укажите почту)
HH_USER_AGENT=AIJobHunter/1.0 (you@example.com)

# ================= Агент =================
# Порог, начиная с которого генерируется сопроводительное письмо
SCORE_THRESHOLD=7
# Утренний прогон (минута час * * *)
RUN_CRON=0 7 * * *
# Включить/выключить встроенный планировщик (1/0)
SCHEDULER_ENABLED=1
# Путь к БД и профилю (относительно корня проекта)
DB_PATH=data/jobs.db
PROFILE_PATH=profile.yaml
